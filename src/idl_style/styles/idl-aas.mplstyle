# AAS journals (ApJ, AJ) — single-column. Apply on top of `idl`:
#     plt.style.use(["idl", "idl-aas"])
# AASTeX onecolumn ~3.5 in; twocolumn ~7.0 in (pass figsize= explicitly for two-column).
figure.figsize: 3.5, 2.6
font.size: 10
axes.labelsize: 10
axes.titlesize: 10
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 9
